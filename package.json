{
  "name": "calcplus",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based, single-user clone of Excel desktop. M1 walking skeleton.",
  "license": "GPL-3.0-only",
  "author": "calcplus contributors",
  "homepage": "https://github.com/msbuk1/calcplus",
  "repository": {
    "type": "git",
    "url": "https://github.com/msbuk1/calcplus.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench:browser": "playwright test -c bench/browser/playwright.config.ts",
    "bench": "npm run bench:browser",
    "licence:check": "node scripts/licence-gate.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run licence:check"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "fast-check": "^4.4.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.13"
  }
}
